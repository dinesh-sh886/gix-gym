# Git attributes for Gix Gym

* text=auto eol=lf

*.java text diff=java
*.kt text diff=kotlin
*.xml text diff=xml
*.yml text
*.yaml text
*.json text
*.md text
*.txt text
*.sh text eol=lf
*.bat text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.class binary
*.jar binary
*.war binary
*.aar binary
*.apk binary
*.so binary
*.dll binary
*.exe binary