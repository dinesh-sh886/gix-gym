# Gix Gym - Environment Variable Template
# Copy to .env and fill in values. NEVER commit .env with real credentials.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme

# Service-specific database credentials (use distinct roles per service)
# MEMBERSHIP_DB_URL=jdbc:postgresql://localhost:5432/gix_membership
# MEMBERSHIP_DB_USER=gix_membership
# MEMBERSHIP_DB_PASSWORD=changeme
# FACILITY_DB_URL=jdbc:postgresql://localhost:5432/gix_facility
# FACILITY_DB_USER=gix_facility
# FACILITY_DB_PASSWORD=changeme
# BOOKING_DB_URL=jdbc:postgresql://localhost:5432/gix_booking
# BOOKING_DB_USER=gix_booking
# BOOKING_DB_PASSWORD=changeme
# PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/gix_payment
# PAYMENT_DB_USER=gix_payment
# PAYMENT_DB_PASSWORD=changeme
# NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/gix_notification
# NOTIFICATION_DB_USER=gix_notification
# NOTIFICATION_DB_PASSWORD=changeme

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# Application
SPRING_PROFILES_ACTIVE=local
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_GIX=DEBUG

# JWT / Auth (placeholders - generate real secrets for local use)
JWT_SECRET=changeme-generate-a-secure-random-secret-at-least-256-bits
JWT_ISSUER=gix-gym
JWT_AUDIENCE=gix-gym-clients

# OpenAPI / API Gateway (when implemented)
# API_GATEWAY_URL=http://localhost:8080