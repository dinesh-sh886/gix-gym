# EditorConfig for Gix Gym

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{md,txt,yml,yaml,json,xml}]
indent_size = 2

[*.java]
indent_size = 4

[*.kt]
indent_size = 4

[*.{ts,js,html,css,scss}]
indent_size = 2