{
    "openapi": "3.0.1",
    "info": {
        "title": "Membership Service API",
        "description": "Gix Gym Membership Management API",
        "license": {
            "name": "Pending",
            "url": ""
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8082",
            "description": "Generated server url"
        }
    ],
    "security": [
        {
            "bearerAuth": []
        }
    ],
    "tags": [
        {
            "name": "Memberships",
            "description": "Membership management API"
        }
    ],
    "paths": {
        "/api/v1/memberships": {
            "get": {
                "tags": [
                    "Memberships"
                ],
                "summary": "List memberships",
                "description": "Lists memberships for the authenticated organization with pagination",
                "operationId": "listMemberships",
                "parameters": [
                    {
                        "name": "arg0",
                        "in": "query",
                        "description": "Page number (0-based)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "default": 0
                        }
                    },
                    {
                        "name": "arg1",
                        "in": "query",
                        "description": "Page size",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "default": 20
                        }
                    },
                    {
                        "name": "arg2",
                        "in": "query",
                        "description": "Sort field",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "createdAt"
                        }
                    },
                    {
                        "name": "arg3",
                        "in": "query",
                        "description": "Sort direction",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "desc"
                        }
                    }
                ],
                "responses": {
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "Memberships retrieved",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PageResponse"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Memberships"
                ],
                "summary": "Create a new membership",
                "description": "Creates a new membership for a member within the authenticated organization and branch",
                "operationId": "createMembership",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/MembershipCreateRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "409": {
                        "description": "Member already has active membership",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "201": {
                        "description": "Membership created",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/MembershipResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/memberships/{membershipId}/freeze": {
            "post": {
                "tags": [
                    "Memberships"
                ],
                "summary": "Freeze a membership",
                "description": "Freezes an active membership",
                "operationId": "freezeMembership",
                "parameters": [],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LifecycleActionRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "404": {
                        "description": "Membership not found",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid state transition",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "Membership frozen",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/MembershipResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/memberships/{membershipId}/cancel": {
            "post": {
                "tags": [
                    "Memberships"
                ],
                "summary": "Cancel a membership",
                "description": "Cancels an active or frozen membership",
                "operationId": "cancelMembership",
                "parameters": [],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LifecycleActionRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "404": {
                        "description": "Membership not found",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "Membership cancelled",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/MembershipResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid state transition",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/memberships/{membershipId}": {
            "get": {
                "tags": [
                    "Memberships"
                ],
                "summary": "Get membership by ID",
                "description": "Retrieves a membership by its ID within the authenticated organization",
                "operationId": "getMembership",
                "parameters": [],
                "responses": {
                    "404": {
                        "description": "Membership not found",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "Membership found",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/MembershipResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "MembershipCreateRequest": {
                "required": [
                    "memberId",
                    "planName",
                    "startDate"
                ],
                "type": "object",
                "properties": {
                    "memberId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "planName": {
                        "maxLength": 100,
                        "minLength": 0,
                        "type": "string"
                    },
                    "startDate": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "endDate": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "ErrorResponse": {
                "type": "object",
                "properties": {
                    "timestamp": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "status": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "error": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "path": {
                        "type": "string"
                    },
                    "correlationId": {
                        "type": "string"
                    },
                    "validationErrors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    }
                }
            },
            "MembershipResponse": {
                "type": "object",
                "properties": {
                    "membershipId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "organizationId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "branchId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "memberId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "planName": {
                        "type": "string"
                    },
                    "startDate": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "endDate": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "ACTIVE",
                            "FROZEN",
                            "CANCELLED",
                            "EXPIRED"
                        ]
                    },
                    "frozenAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "cancelledAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "LifecycleActionRequest": {
                "required": [
                    "effectiveAt"
                ],
                "type": "object",
                "properties": {
                    "effectiveAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "PageResponse": {
                "type": "object",
                "properties": {
                    "content": {
                        "type": "array",
                        "items": {
                            "type": "object"
                        }
                    },
                    "pageNumber": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "pageSize": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "totalElements": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "totalPages": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "first": {
                        "type": "boolean"
                    },
                    "last": {
                        "type": "boolean"
                    },
                    "empty": {
                        "type": "boolean"
                    }
                }
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "JWT token for authentication",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}
